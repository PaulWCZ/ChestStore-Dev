{
  "chest": "0.4",
  "name": "status",
  "title": "Status",
  "description": "Tell your customers whether your services work: a public status page, incidents and their updates, planned maintenance.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": ["editor"],
  "role_labels": { "editor": "Editor" },
  "public": true,
  "capabilities": ["database", "members", "notifications"],
  "receives": ["member.*"],
  "schedules": [{ "name": "updates", "cron": "*/15 * * * *" }],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": ["/assets/"]
  }
}
