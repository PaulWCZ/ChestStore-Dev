{
  "chest": "0.7",
  "name": "status",
  "title": "Status",
  "description": "Tell your customers whether your services work: a public status page, incidents and their updates, planned maintenance.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "editor"
  ],
  "role_labels": {
    "editor": "Editor"
  },
  "public": true,
  "capabilities": [
    "database",
    "members",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*"
  ],
  "emits": {
    "status.incident": {
      "description": "An incident on the public status page changes",
      "data": {
        "incident": "id",
        "action": "text",
        "status": "text",
        "impact": "text",
        "language": "text",
        "title": "text",
        "titles": "text",
        "services": "text",
        "startedAt": "time",
        "resolvedAt": "time?",
        "url": "text?",
        "update": "id?",
        "updatedAt": "time"
      }
    }
  },
  "realtime": {
    "channels": [
      {
        "name": "team"
      }
    ],
    "feeds": [
      {
        "table": "incidents",
        "channel": "team",
        "columns": [
          "id"
        ]
      },
      {
        "table": "updates",
        "channel": "team",
        "columns": [
          "id"
        ]
      },
      {
        "table": "components",
        "channel": "team",
        "columns": [
          "id"
        ]
      },
      {
        "table": "check_states",
        "channel": "team",
        "columns": [
          "component_id"
        ]
      },
      {
        "table": "heartbeats",
        "channel": "team",
        "columns": [
          "component_id"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "updates",
      "cron": "*/15 * * * *"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
