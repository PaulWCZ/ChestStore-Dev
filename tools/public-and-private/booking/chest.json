{
  "version": 2,
  "name": "booking",
  "title": "Booking",
  "description": "Let customers book a time with your team: a page per person, their hours, no double booking.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": ["admin", "host"],
  "role_labels": { "admin": "Administrator", "host": "Host" },
  "public": true,
  "csp": "tool",
  "capabilities": ["database", "members", "notifications"],
  "receives": ["member.*"],
  "network": ["calendar.google.com", "outlook.office365.com", "outlook.live.com", "*.icloud.com"],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": ["/_next/static/"]
  }
}
