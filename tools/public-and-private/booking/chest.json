{
  "chest": "0.7",
  "name": "booking",
  "title": "Booking",
  "description": "Let customers book a time with your team: a page per person, their hours, no double booking.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "admin",
    "host"
  ],
  "role_labels": {
    "admin": "Administrator",
    "host": "Host"
  },
  "public": true,
  "capabilities": [
    "database",
    "members",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*",
    "hiring.busy",
    "leave.busy"
  ],
  "emits": {
    "booking.busy": {
      "description": "A host's busy times changed (times only)",
      "data": {
        "v": "number",
        "member": "member",
        "at": "time",
        "from": "time",
        "to": "time",
        "spans": "text"
      }
    },
    "booking.confirmed": {
      "description": "A booking is made or moved: who booked, which type, when",
      "data": {
        "v": "number",
        "booking": "id",
        "status": "text",
        "at": "time",
        "host": "member?",
        "start": "time",
        "end": "time",
        "type": "id?",
        "typeName": "text",
        "typeNameFr": "text",
        "kind": "text",
        "contactName": "text",
        "contactEmail": "text",
        "contactPhone": "text?",
        "contactLanguage": "text",
        "source": "text",
        "moves": "number",
        "path": "text"
      }
    },
    "booking.cancelled": {
      "description": "A booking is cancelled: who booked, which type, when",
      "data": {
        "v": "number",
        "booking": "id",
        "status": "text",
        "at": "time",
        "host": "member?",
        "start": "time",
        "end": "time",
        "type": "id?",
        "typeName": "text",
        "typeNameFr": "text",
        "kind": "text",
        "contactName": "text",
        "contactEmail": "text",
        "contactPhone": "text?",
        "contactLanguage": "text",
        "source": "text",
        "moves": "number",
        "path": "text",
        "cancelledBy": "text?"
      }
    }
  },
  "realtime": {
    "channels": [
      {
        "name": "agenda:*",
        "join": [
          "admin",
          "host"
        ]
      }
    ],
    "feeds": [
      {
        "table": "bookings",
        "channel": "agenda:{member_id}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "blocks",
        "channel": "agenda:{member_id}",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "network": [
    "calendar.google.com",
    "outlook.office365.com",
    "outlook.live.com",
    "*.icloud.com"
  ],
  "schedules": [
    {
      "name": "reminders",
      "cron": "5 * * * *"
    },
    {
      "name": "cleanup",
      "cron": "40 3 * * *"
    },
    {
      "name": "calendars",
      "cron": "*/15 * * * *"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
