{
  "chest": "0.7",
  "name": "forms",
  "title": "Forms",
  "description": "Build a form in minutes, share one link, read the answers: surveys, sign-ups, requests, feedback.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "manager",
    "creator",
    "member"
  ],
  "role_labels": {
    "manager": "Manager",
    "creator": "Creator",
    "member": "Member"
  },
  "public": true,
  "capabilities": [
    "database",
    "files",
    "members",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*"
  ],
  "emits": {
    "forms.answered": {
      "description": "A form is answered: its answers, as text",
      "data": {
        "form": "id",
        "title": "text",
        "answer": "id",
        "language": "text",
        "fields": "text",
        "email": "text?",
        "member": "member?"
      }
    },
    "forms.contact": {
      "description": "An answer gives a contact: name, email, phone, company, message",
      "data": {
        "v": "number",
        "form": "id",
        "formTitle": "text",
        "answer": "id",
        "answeredAt": "time",
        "language": "text",
        "path": "text",
        "contactName": "text?",
        "contactEmail": "text?",
        "contactPhone": "text?",
        "contactCompany": "text?",
        "message": "text?",
        "member": "member?"
      }
    },
    "forms.request": {
      "description": "An answer asks for help: subject, details, who asks, the answers",
      "data": {
        "v": "number",
        "form": "id",
        "formTitle": "text",
        "answer": "id",
        "answeredAt": "time",
        "language": "text",
        "path": "text",
        "subject": "text",
        "details": "text?",
        "requester": "member?",
        "requesterName": "text?",
        "requesterEmail": "text?",
        "fields": "text"
      }
    }
  },
  "realtime": {
    "channels": [
      {
        "name": "form:{id}",
        "join": {
          "table": "form_live",
          "key": "form_id",
          "member": "member_id"
        }
      },
      {
        "name": "team"
      },
      {
        "name": "managers",
        "join": [
          "manager"
        ]
      },
      {
        "name": "mine:{member}"
      }
    ],
    "feeds": [
      {
        "table": "answers",
        "channel": "form:{form_id}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "forms",
        "channel": "form:{id}",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "bell",
      "cron": "*/15 * * * *"
    },
    {
      "name": "cleanup",
      "cron": "20 3 * * *"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
