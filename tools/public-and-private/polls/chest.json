{
  "chest": "0.4",
  "name": "polls",
  "title": "Polls",
  "description": "Ask the team a quick question, find a date that suits everyone, or run a short anonymous survey.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "organiser",
    "member"
  ],
  "role_labels": {
    "organiser": "Organiser",
    "member": "Member"
  },
  "public": true,
  "capabilities": [
    "database",
    "members",
    "notifications"
  ],
  "receives": [
    "member.*"
  ],
  "schedules": [
    {
      "name": "pass",
      "cron": "*/15 * * * *"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
