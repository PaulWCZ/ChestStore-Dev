{
  "chest": "0.7",
  "name": "polls",
  "title": "Polls",
  "description": "Ask the team a quick question, find a date that suits everyone, or run a short anonymous survey.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "organiser",
    "member"
  ],
  "role_labels": {
    "organiser": "Organiser",
    "member": "Member"
  },
  "public": true,
  "capabilities": [
    "database",
    "members",
    "members.groups",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*"
  ],
  "realtime": {
    "channels": [
      {
        "name": "polls"
      },
      {
        "name": "poll:{id}",
        "join": {
          "table": "poll_live",
          "key": "poll_id",
          "member": "member_id"
        }
      },
      {
        "name": "mine:{member}"
      }
    ],
    "feeds": [
      {
        "table": "polls",
        "channel": "polls",
        "columns": [
          "id"
        ]
      },
      {
        "table": "comments",
        "channel": "poll:{poll_id}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "replies",
        "channel": "poll:{poll_id}",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "pass",
      "cron": "*/15 * * * *"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
