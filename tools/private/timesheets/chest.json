{
  "chest": "0.7",
  "name": "timesheets",
  "title": "Timesheets",
  "description": "Record time on clients' projects with a timer or a week grid, approve each week, see where it went and what it earned.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "manager",
    "member"
  ],
  "role_labels": {
    "manager": "Manager",
    "member": "Member"
  },
  "capabilities": [
    "database",
    "members",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*",
    "quotes.invoiced"
  ],
  "emits": {
    "timesheets.billable": {
      "description": "Billable time handed over to be invoiced",
      "data": {
        "handoff": "id",
        "project": "id",
        "projectName": "text",
        "client": "id?",
        "clientName": "text?",
        "from": "date",
        "to": "date",
        "currency": "text",
        "minutes": "number",
        "amount": "number?",
        "entries": "number",
        "lines": "text",
        "path": "text"
      }
    },
    "timesheets.billable-cancelled": {
      "description": "Billable time handed over is taken back",
      "data": {
        "handoff": "id"
      }
    }
  },
  "realtime": {
    "channels": [
      {
        "name": "mine:{member}"
      },
      {
        "name": "team",
        "join": [
          "manager"
        ]
      }
    ],
    "feeds": [
      {
        "table": "entries",
        "channel": "team",
        "columns": [
          "id"
        ]
      },
      {
        "table": "weeks",
        "channel": "team",
        "columns": [
          "member_id",
          "week"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "friday",
      "cron": "30 15 * * 5"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
