{
  "version": 2,
  "name": "timesheets",
  "title": "Timesheets",
  "description": "Record time on clients' projects with a timer or a week grid, approve each week, see where it went and what it earned.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "manager",
    "member"
  ],
  "role_labels": {
    "manager": "Manager",
    "member": "Member"
  },
  "capabilities": [
    "database",
    "members",
    "notifications"
  ],
  "receives": [
    "member.*"
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/_next/static/"
    ]
  }
}
