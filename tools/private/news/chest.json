{
  "chest": "0.4",
  "name": "news",
  "title": "News",
  "description": "The company's front page: announcements, events, new colleagues — and who has read what matters.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "publisher",
    "reader"
  ],
  "role_labels": {
    "publisher": "Publisher",
    "reader": "Reader"
  },
  "capabilities": [
    "database",
    "files",
    "members",
    "notifications"
  ],
  "receives": [
    "member.*"
  ],
  "schedules": [
    {
      "name": "publish",
      "cron": "*/15 * * * *"
    },
    {
      "name": "digest",
      "cron": "30 8 * * 1"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
