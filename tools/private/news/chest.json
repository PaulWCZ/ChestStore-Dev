{
  "chest": "0.7",
  "name": "news",
  "title": "News",
  "description": "The company's front page: announcements, events, new colleagues — and who has read what matters.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "publisher",
    "reader"
  ],
  "role_labels": {
    "publisher": "Publisher",
    "reader": "Reader"
  },
  "capabilities": [
    "database",
    "files",
    "members",
    "members.groups",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*"
  ],
  "realtime": {
    "channels": [
      {
        "name": "news"
      },
      {
        "name": "post:*"
      },
      {
        "name": "mine:{member}"
      }
    ],
    "feeds": [
      {
        "table": "posts",
        "channel": "news",
        "columns": [
          "id"
        ]
      },
      {
        "table": "comments",
        "channel": "post:{post_id}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "reactions",
        "channel": "post:{post_id}",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "publish",
      "cron": "*/15 * * * *"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
