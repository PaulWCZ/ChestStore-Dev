{
  "chest": "0.4",
  "name": "expenses",
  "title": "Expenses",
  "description": "Snap a receipt, get paid back: expense claims, approvals, mileage, and a clean monthly export for the accountant.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "accountant",
    "approver",
    "employee"
  ],
  "role_labels": {
    "accountant": "Accountant",
    "approver": "Approver",
    "employee": "Employee"
  },
  "capabilities": [
    "database",
    "files",
    "members",
    "notifications"
  ],
  "receives": [
    "member.*"
  ],
  "schedules": [
    {
      "name": "reminder",
      "cron": "0 9 25 * *"
    },
    {
      "name": "cleanup",
      "cron": "40 3 * * *"
    }
  ],
  "env": [
    "BANK_DETAILS_KEY"
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
