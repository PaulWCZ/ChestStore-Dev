{
  "chest": "0.4",
  "name": "equipment",
  "title": "Equipment",
  "description": "Know who has which laptop, phone, screen, licence, badge or key — give, take back, print labels, see what ends soon.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "manager",
    "member"
  ],
  "role_labels": {
    "manager": "Equipment manager",
    "member": "Member"
  },
  "capabilities": [
    "database",
    "files",
    "members",
    "notifications"
  ],
  "receives": [
    "member.*"
  ],
  "schedules": [
    {
      "name": "weekly",
      "cron": "50 7 * * 1"
    },
    {
      "name": "intune",
      "cron": "40 5 * * *"
    },
    {
      "name": "returns",
      "cron": "*/15 * * * *"
    }
  ],
  "network": [
    "login.microsoftonline.com",
    "graph.microsoft.com"
  ],
  "env": [
    "INTUNE_TENANT_ID",
    "INTUNE_CLIENT_ID",
    "INTUNE_CLIENT_SECRET"
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
