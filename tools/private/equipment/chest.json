{
  "chest": "0.7",
  "name": "equipment",
  "title": "Equipment",
  "description": "Know who has which laptop, phone, screen, licence, badge or key — give, take back, print labels, see what ends soon.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "manager",
    "member"
  ],
  "role_labels": {
    "manager": "Equipment manager",
    "member": "Member"
  },
  "capabilities": [
    "database",
    "files",
    "members",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*",
    "people.leaving",
    "people.leaving-cancelled"
  ],
  "emits": {
    "equipment.returned": {
      "description": "Everything a leaving person held is back",
      "data": {
        "member": "member"
      }
    }
  },
  "schedules": [
    {
      "name": "weekly",
      "cron": "50 7 * * 1"
    },
    {
      "name": "intune",
      "cron": "40 5 * * *"
    },
    {
      "name": "returns",
      "cron": "*/15 * * * *"
    }
  ],
  "realtime": {
    "channels": [
      {
        "name": "managers",
        "join": [
          "manager"
        ]
      },
      {
        "name": "mine:{member}"
      }
    ],
    "feeds": [
      {
        "table": "items",
        "channel": "managers",
        "columns": [
          "id"
        ]
      },
      {
        "table": "requests",
        "channel": "managers",
        "columns": [
          "id"
        ]
      },
      {
        "table": "problems",
        "channel": "managers",
        "columns": [
          "id"
        ]
      },
      {
        "table": "inventories",
        "channel": "managers",
        "columns": [
          "id"
        ]
      },
      {
        "table": "sightings",
        "channel": "managers",
        "columns": [
          "inventory_id",
          "item_id"
        ]
      }
    ]
  },
  "network": [
    "login.microsoftonline.com",
    "graph.microsoft.com"
  ],
  "env": [
    "INTUNE_TENANT_ID",
    "INTUNE_CLIENT_ID",
    "INTUNE_CLIENT_SECRET"
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
