{
  "chest": "0.7",
  "name": "wiki",
  "title": "Wiki",
  "description": "Write down how the company works — handbook, policies, how-tos — and find any answer in seconds.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "editor",
    "reader"
  ],
  "role_labels": {
    "editor": "Editor",
    "reader": "Reader"
  },
  "capabilities": [
    "database",
    "files",
    "members",
    "members.groups",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*"
  ],
  "realtime": {
    "channels": [
      {
        "name": "page:{id}",
        "join": {
          "table": "page_live",
          "key": "page_id",
          "member": "member_id"
        },
        "presence": true
      }
    ],
    "feeds": [
      {
        "table": "pages",
        "channel": "page:{id}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "page_comments",
        "channel": "page:{page_id}",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "reviews",
      "cron": "40 7 * * 1-5"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
