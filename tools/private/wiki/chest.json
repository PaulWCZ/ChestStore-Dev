{
  "chest": "0.4",
  "name": "wiki",
  "title": "Wiki",
  "description": "Write down how the company works — handbook, policies, how-tos — and find any answer in seconds.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "editor",
    "reader"
  ],
  "role_labels": {
    "editor": "Editor",
    "reader": "Reader"
  },
  "capabilities": [
    "database",
    "files",
    "members",
    "notifications"
  ],
  "receives": [
    "member.*"
  ],
  "schedules": [
    {
      "name": "reviews",
      "cron": "40 7 * * 1-5"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
