{
  "chest": "0.7",
  "name": "leave",
  "title": "Leave",
  "description": "Ask for time off, get an answer in one click, see who is away. French rules built in: jours ouvrés or ouvrables, public holidays, earned leave.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "hr",
    "manager",
    "employee"
  ],
  "role_labels": {
    "hr": "HR",
    "manager": "Manager",
    "employee": "Employee"
  },
  "capabilities": [
    "database",
    "members",
    "members.groups",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*",
    "people.record",
    "people.leaving",
    "people.leaving-cancelled"
  ],
  "emits": {
    "leave.approved": {
      "description": "A leave is approved: who is away, from when to when",
      "data": {
        "member": "member",
        "from": "date",
        "to": "date",
        "fromHalf": "text",
        "toHalf": "text",
        "request": "id"
      }
    },
    "leave.cancelled": {
      "description": "An approved leave no longer stands: who, which days",
      "data": {
        "member": "member",
        "from": "date",
        "to": "date",
        "fromHalf": "text",
        "toHalf": "text",
        "request": "id"
      }
    },
    "leave.busy": {
      "description": "Someone's days off changed (times only)",
      "data": {
        "v": "number",
        "member": "member",
        "at": "time",
        "from": "time",
        "to": "time",
        "spans": "text"
      }
    }
  },
  "realtime": {
    "channels": [
      {
        "name": "leave"
      }
    ],
    "feeds": [
      {
        "table": "requests",
        "channel": "leave",
        "columns": [
          "id"
        ]
      },
      {
        "table": "ledger",
        "channel": "leave",
        "columns": [
          "id"
        ]
      },
      {
        "table": "leave_types",
        "channel": "leave",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "morning",
      "cron": "30 8 * * 1-5"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
