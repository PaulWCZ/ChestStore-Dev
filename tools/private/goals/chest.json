{
  "chest": "0.7",
  "name": "goals",
  "title": "Goals",
  "description": "Agree on what matters this quarter: company and team objectives, key results, weekly check-ins, progress for all to see.",
  "icon": "chest/icon.svg",
  "preview": "chest/preview.png",
  "roles": [
    "admin",
    "member"
  ],
  "role_labels": {
    "admin": "Administrator",
    "member": "Member"
  },
  "capabilities": [
    "database",
    "members",
    "members.groups",
    "notifications",
    "realtime"
  ],
  "receives": [
    "member.*",
    "crm.deal.won",
    "crm.deal.reopened",
    "tasks.card.done",
    "tasks.card.reopened",
    "helpdesk.ticket.solved",
    "helpdesk.ticket.reopened",
    "hiring.hired",
    "hiring.hire-cancelled"
  ],
  "realtime": {
    "channels": [
      {
        "name": "objective:{key}",
        "join": {
          "table": "objective_live",
          "key": "objective_key",
          "member": "member_id"
        }
      }
    ],
    "feeds": [
      {
        "table": "objectives",
        "channel": "objective:{live_key}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "key_results",
        "channel": "objective:{live_key}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "check_ins",
        "channel": "objective:{live_key}",
        "columns": [
          "id"
        ]
      },
      {
        "table": "comments",
        "channel": "objective:{live_key}",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "schedules": [
    {
      "name": "reminder",
      "cron": "45 8 * * 5"
    },
    {
      "name": "week",
      "cron": "50 6 * * 1"
    }
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
