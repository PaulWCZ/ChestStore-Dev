{
  "chest": "0.7",
  "name": "my-tool",
  "title": "My tool",
  "description": "What the tool does, in one sentence.",
  "roles": [
    "member"
  ],
  "capabilities": [
    "database",
    "members",
    "realtime"
  ],
  "receives": [
    "member.*"
  ],
  "realtime": {
    "channels": [
      {
        "name": "notes"
      }
    ],
    "feeds": [
      {
        "table": "notes",
        "channel": "notes",
        "columns": [
          "id"
        ]
      }
    ]
  },
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/assets/"
    ]
  }
}
