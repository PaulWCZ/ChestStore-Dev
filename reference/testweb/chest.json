{
  "chest": "0.4",
  "name": "testweb",
  "title": "Server test bench",
  "description": "The web server that exercises the tool contract of a Chest.",
  "icon": "chest/icon.svg",
  "roles": [
    "reader",
    "editor"
  ],
  "public": true,
  "capabilities": [
    "database",
    "files",
    "members",
    "notifications",
    "ai"
  ],
  "ai": {
    "monthly": 2,
    "purpose": "Summarises a member's text in one sentence"
  },
  "receives": [
    "member.*"
  ],
  "schedules": [
    {
      "name": "morning",
      "cron": "30 7 * * 1-5"
    }
  ],
  "network": [
    "allowed.egress.test",
    "*.forbidden.egress.test"
  ],
  "env": [
    "TESTWEB_GREETING"
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/static/"
    ]
  }
}
