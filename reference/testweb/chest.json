{
  "chest": "0.5",
  "name": "testweb",
  "title": "Server test bench",
  "description": "The web server that exercises the tool contract of a Chest.",
  "icon": "chest/icon.svg",
  "roles": [
    "reader",
    "editor"
  ],
  "public": true,
  "capabilities": [
    "database",
    "files",
    "members",
    "members.groups",
    "notifications",
    "ai",
    "realtime"
  ],
  "ai": {
    "monthly": 2,
    "purpose": "Summarises a member's text in one sentence"
  },
  "realtime": {
    "channels": [
      {
        "name": "lobby",
        "send": true,
        "presence": true
      },
      {
        "name": "room:{id}",
        "join": {
          "table": "chat_members",
          "key": "room",
          "member": "member_id"
        }
      }
    ],
    "feeds": [
      {
        "table": "chat_messages",
        "channel": "room:{room}",
        "columns": [
          "id",
          "room",
          "author",
          "text"
        ]
      }
    ]
  },
  "emits": {
    "note.added": {
      "description": "A note is added",
      "data": {
        "note": "id",
        "author": "member",
        "text": "text"
      }
    }
  },
  "receives": [
    "member.*",
    "note.added"
  ],
  "schedules": [
    {
      "name": "morning",
      "cron": "30 7 * * 1-5"
    }
  ],
  "network": [
    "allowed.egress.test",
    "*.forbidden.egress.test"
  ],
  "env": [
    "TESTWEB_GREETING"
  ],
  "build": {
    "runtime": "node",
    "install": "npm ci",
    "command": "npm run build",
    "start": "npm start",
    "port": 3000,
    "static": [
      "/static/"
    ]
  }
}
