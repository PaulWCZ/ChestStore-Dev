{
  "name": "@argentic/chest-app",
  "version": "0.1.0-studio.5",
  "description": "The server and browser machinery of a Chest tool on Hono and React: pages rendered on the server, islands, typed actions callable from an island or a plain form, a refresh that keeps the page's state, the member's words and formats, the strict policy, logs, the database, tests.",
  "license": "MIT",
  "author": "Argentic",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./members": {
      "types": "./dist/members.d.ts",
      "default": "./dist/members.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "npm run build && tsc -p tsconfig.json --noEmit && node scripts/test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@argentic/chest-sdk": ">=0.4.1-0",
    "@argentic/chest-ui": ">=0.2.6-studio.1",
    "@hono/node-server": ">=2.1",
    "hono": ">=4.13",
    "postgres": ">=3.4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@argentic/chest-sdk": "file:../starter/vendor/chest-sdk-0.4.1.tgz",
    "@argentic/chest-ui": "file:../starter/vendor/chest-ui-0.2.6-studio.1.tgz",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@hono/node-server": "2.1.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "hono": "4.13.12",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
